[Unit]
Description=Order Management Microservice
After=network.target postgresql.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/order-management
ExecStart=/opt/order-management/oms
Restart=always
RestartSec=5s
EnvironmentFile=/opt/order-management/.env
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
